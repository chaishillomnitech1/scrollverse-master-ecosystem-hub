{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrollverse.example/schemas/proof-record.schema.json",
  "title": "ScrollVerse Proof Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof_id",
    "recorded_at",
    "claim",
    "proof_class",
    "status",
    "evidence"
  ],
  "properties": {
    "proof_id": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "proof_class": {
      "enum": [
        "source_file",
        "hash",
        "commit",
        "pull_request",
        "ci_run",
        "test_result",
        "deployment",
        "endpoint_observation",
        "transaction",
        "event_log",
        "analytics_export",
        "screenshot",
        "storage_pin",
        "legal_document",
        "provider_record",
        "other"
      ]
    },
    "status": {
      "enum": [
        "verified",
        "partially_verified",
        "pending",
        "failed",
        "disputed",
        "not_applicable"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference",
          "observed_at"
        ],
        "properties": {
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verifier": {
      "type": "string"
    },
    "verification_method": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "related_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}
